# Copy to .env and adjust as needed.
PORT=3001
WEB_URL=http://localhost:5173

# District voice chat (LiveKit). All three are required to enable voice.
# The API secret MUST stay server-side: browsers only receive short-lived
# join tokens. Never commit real credentials.
# Get free credentials at https://cloud.livekit.io (or run livekit-server locally).
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Task 10: Google sign-in + account sessions. All three control auth behavior.
# Never commit real values.
# GOOGLE_CLIENT_ID: Google OAuth client id (also the ID-token audience).
#   When empty, Google sign-in is disabled ("Google sign-in is not configured").
# SESSION_COOKIE_SECRET: pepper for session-token hashes (generate a long random string).
# AUTH_REQUIRED: "true" = Google account required to play (production);
#   anything else = development guest mode (existing tests use this).
#GOOGLE_CLIENT_ID=
#SESSION_COOKIE_SECRET=
#AUTH_REQUIRED=false
