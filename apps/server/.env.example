# Copy to .env and adjust as needed.
PORT=3001
WEB_URL=http://localhost:5173

# District voice chat (LiveKit). All three are required to enable voice.
# The API secret MUST stay server-side: browsers only receive short-lived
# join tokens. Never commit real credentials.
# Get free credentials at https://cloud.livekit.io (or run livekit-server locally).
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
