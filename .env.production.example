# Kerala Battle — production environment template.
#
# Copy to `.env.production` (gitignored) and fill in REAL values.
# Never commit real secrets. Never put secrets in docker-compose.yml.

# --- required in production -------------------------------------------
# Public origin(s) of the web app, comma-separated. No localhost here.
WEB_URLS=https://battle.example.com

# Random 32+ byte secret for session signing. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_COOKIE_SECRET=

# Production must require Google accounts (guests off).
AUTH_REQUIRED=true

# Google OAuth client id (also the GIS button's client id).
GOOGLE_CLIENT_ID=

# --- voice (optional; all three together or none) -----------------------
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- storage ------------------------------------------------------------
# Inside the container this is the /data volume.
DATA_DIR=/data

# --- operations ---------------------------------------------------------
# Bearer token for GET /internal/metrics. If unset, the endpoint 404s.
INTERNAL_METRICS_TOKEN=

# "true" shows a maintenance notice and blocks new games/queues.
MAINTENANCE_MODE=false

# debug|info|warn|error (default: info in production)
LOG_LEVEL=info

# --- build metadata (set via docker build --build-arg) ------------------
APP_VERSION=0.1.0
GIT_COMMIT=unknown
